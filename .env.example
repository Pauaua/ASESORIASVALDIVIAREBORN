# ─────────────────────────────────────────────────────────────────────────────
# Asesorías Valdivia — variables de entorno
#
# Copia este archivo como `.env` (desarrollo) y completa los valores.
# En Vercel se configuran en Project Settings → Environment Variables.
# NUNCA subas `.env` al repositorio.
#
# Se validan al arrancar (src/env.ts). Las marcadas como OBLIGATORIA detienen el
# arranque si faltan; las opcionales solo desactivan su funcionalidad.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos (OBLIGATORIA) ──────────────────────────────────────────────
# Desarrollo: Postgres local de docker-compose.yml (puerto 5434).
# Producción: URL PÚBLICA de Railway (Postgres → Connect → Public Network), con
#   `?sslmode=no-verify` al final: Railway usa un certificado autofirmado y el driver
#   `pg` trata `sslmode=require` como `verify-full`, que lo rechazaría.
DATABASE_URL="postgresql://av:av_local@localhost:5434/asesorias_valdivia?schema=public"
# Conexiones máximas por instancia de función (opcional, por defecto 5).
DATABASE_POOL_MAX=5

# ── Auth.js (OBLIGATORIA) ────────────────────────────────────────────────────
# Mínimo 32 caracteres. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
# URL pública del sitio. En Vercel no hace falta (se detecta sola).
AUTH_URL="http://localhost:3000"

# ── URL pública de la app ────────────────────────────────────────────────────
# Se usa en metadata/SEO, sitemap y en el enlace del correo de recuperación.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Correo — Resend (opcional) ───────────────────────────────────────────────
# Sin estas tres variables los formularios se guardan igual, pero no se envía correo.
RESEND_API_KEY=""
# Remitente con dominio verificado en Resend, p. ej. "Asesorías Valdivia <contacto@asesoriasvaldivia.cl>"
EMAIL_FROM=""
# Bandeja que recibe las notificaciones de contacto, cotización y solicitudes de registro.
EMAIL_TO="contacto@asesoriasvaldivia.cl"

# ── Vercel Blob (opcional) ───────────────────────────────────────────────────
# Imágenes de perfil y PDFs de recursos. Sin él, no se pueden subir archivos.
BLOB_READ_WRITE_TOKEN=""

# ── Daemon de automatización SII (opcional) ──────────────────────────────────
# URL del túnel Cloudflare del PC de la oficina. La actualiza `iniciar.ps1` del daemon
# automáticamente en el proyecto de Vercel indicado por VERCEL_PROJECT_ID (en ese PC).
# En local, con el mock (npm run mock:daemon): DAEMON_URL="http://localhost:8765" y DAEMON_SECRET="dev-secret".
DAEMON_URL=""
# Mismo valor que DAEMON_SECRET en el .env del daemon.
DAEMON_SECRET=""

# ── Cron de recordatorio de boletas (opcional) ───────────────────────────────
# Vercel Cron lo envía como "Authorization: Bearer <CRON_SECRET>".
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# ── Cloudflare Turnstile (opcional) ──────────────────────────────────────────
# Captcha de los formularios públicos. Si se omite, se usa solo honeypot + rate limit.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
